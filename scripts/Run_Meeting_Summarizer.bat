@echo off
chcp 65001 > nul
title מסכם פגישות חכם - D-Dialog
cd /d "%~dp0"

echo ======================================================
echo           מסכם פגישות חכם מבוסס AI - D-Dialog
echo ======================================================
echo.

if "%~1"=="" (
    echo פותח חלון לבחירת קובץ שמע...
    python meeting_summarizer.py
) else (
    echo מעבד את הקובץ שנגרר: "%~nx1"
    python meeting_summarizer.py "%~1"
)

echo.
echo ======================================================
echo התהליך הסתיים.
echo ======================================================
pause
